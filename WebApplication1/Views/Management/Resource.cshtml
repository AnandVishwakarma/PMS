@model WebApplication1.Models.ResourceModel
@{
    ViewData["Title"] = "Resource Management";
    var resources = ViewBag.Resources as List<WebApplication1.Models.ResourceModel> ?? new();
    var designations = ViewBag.Designations as List<WebApplication1.Models.DesignationModel> ?? new();
}

<div class="container mt-4">
    <h2>Resource Management</h2>
    <hr />

    <div class="card p-3 mb-4 bg-light">
        <form asp-action="SaveResource" method="post">
            <input type="hidden" asp-for="ResourceId" id="ResourceId" value="0" />
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Full Name</label>
                    <input asp-for="FullName" id="FullName" class="form-control" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Designation</label>
                    <select asp-for="DesignationId" id="DesignationId" class="form-select" required>
                        <option value="">-- Select Designation --</option>
                        @foreach (var d in designations)
                        {
                            <option value="@d.DesignationId">@d.Designation</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Hourly Rate</label>
                    <input asp-for="HourlyRate" id="HourlyRate" type="number" step="0.01" class="form-control" required />
                </div>
                <div class="col-md-4 d-flex align-items-center mt-4">
                    <div class="form-check me-3">
                        <input asp-for="EfficiencyFactor" id="EfficiencyFactor" class="form-check-input" type="checkbox" />
                        <label class="form-check-label" for="EfficiencyFactor">Efficiency Factor</label>
                    </div>
                    <div class="form-check">
                        <input asp-for="IsActive" id="IsActive" class="form-check-input" type="checkbox" checked />
                        <label class="form-check-label" for="IsActive">Is Active</label>
                    </div>
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" id="btnSave" class="btn btn-primary">Add</button>
                <button type="button" class="btn btn-secondary" onclick="resetResourceForm()">Cancel</button>
            </div>
        </form>
    </div>

    <h4>Resources List</h4>
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Full Name</th>
                <th>Designation</th>
                <th>Hourly Rate</th>
                <th>Efficiency</th>
                <th>Active</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in resources)
            {
                <tr>
                    <td>@r.ResourceId</td>
                    <td>@r.FullName</td>
                    <td>@r.DesignationName</td>
                    <td>@r.HourlyRate.ToString("F2")</td>
                    <td>@(r.EfficiencyFactor ? "Yes" : "No")</td>
                    <td>@(r.IsActive ? "Active" : "Inactive")</td>
                    <td>
                        <button class="btn btn-sm btn-warning" onclick='editResource(@r.ResourceId, "@r.FullName", @r.DesignationId, @r.HourlyRate, @r.EfficiencyFactor.ToString().ToLower(), @r.IsActive.ToString().ToLower())'>Edit</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    function editResource(id, name, desigId, rate, eff, active) {
        document.getElementById("ResourceId").value = id;
        document.getElementById("FullName").value = name;
        document.getElementById("DesignationId").value = desigId;
        document.getElementById("HourlyRate").value = rate;
        document.getElementById("EfficiencyFactor").checked = eff;
        document.getElementById("IsActive").checked = active;
        document.getElementById("btnSave").textContent = "Update";
        document.getElementById("btnSave").className = "btn btn-success";
    }

    function resetResourceForm() {
        document.getElementById("ResourceId").value = 0;
        document.getElementById("FullName").value = "";
        document.getElementById("DesignationId").value = "";
        document.getElementById("HourlyRate").value = "";
        document.getElementById("EfficiencyFactor").checked = false;
        document.getElementById("IsActive").checked = true;
        document.getElementById("btnSave").textContent = "Add";
        document.getElementById("btnSave").className = "btn btn-primary";
    }
</script>