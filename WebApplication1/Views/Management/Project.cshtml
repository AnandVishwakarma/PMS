@model WebApplication1.Models.ProjectModel
@{
    ViewData["Title"] = "Project Management";
    var projects = ViewBag.Projects as List<WebApplication1.Models.ProjectModel> ?? new();
}

<div class="container mt-4">
    <h2>Project Management</h2>
    <hr />

    <div class="card p-3 mb-4 bg-light">
        <form asp-action="SaveProject" method="post">
            <input type="hidden" asp-for="ProjectId" id="ProjectId" value="0" />
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Project Name</label>
                    <input asp-for="ProjectName" id="ProjectName" class="form-control" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Start Date</label>
                    <input asp-for="StartSate" id="StartSate" type="date" class="form-control" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">End Date</label>
                    <input asp-for="EndDate" id="EndDate" type="date" class="form-control" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Estimated Budget</label>
                    <input asp-for="EstimatedBudget" id="EstimatedBudget" type="number" step="0.01" class="form-control" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Approved Budget</label>
                    <input asp-for="ApprovedBudget" id="ApprovedBudget" type="number" step="0.01" class="form-control" required />
                </div>
                <div class="col-md-4 d-flex align-items-center mt-4">
                    <div class="form-check">
                        <input asp-for="RiskFactor" id="RiskFactor" class="form-check-input" type="checkbox" />
                        <label class="form-check-label" for="RiskFactor">Risk Factor</label>
                    </div>
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" id="btnSave" class="btn btn-primary">Add</button>
                <button type="button" class="btn btn-secondary" onclick="resetProjectForm()">Cancel</button>
            </div>
        </form>
    </div>

    <h4>Projects List</h4>
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Project Name</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Est. Budget</th>
                <th>App. Budget</th>
                <th>Risk Factor</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in projects)
            {
                <tr>
                    <td>@p.ProjectId</td>
                    <td>@p.ProjectName</td>
                    <td>@p.StartSate.ToString("yyyy-MM-dd")</td>
                    <td>@p.EndDate.ToString("yyyy-MM-dd")</td>
                    <td>@p.EstimatedBudget.ToString("F2")</td>
                    <td>@p.ApprovedBudget.ToString("F2")</td>
                    <td>@(p.RiskFactor ? "Yes" : "No")</td>
                    <td>
                        <button class="btn btn-sm btn-warning" onclick='editProject(@p.ProjectId, "@p.ProjectName", "@p.StartSate.ToString("yyyy-MM-dd")", "@p.EndDate.ToString("yyyy-MM-dd")", @p.EstimatedBudget, @p.ApprovedBudget, @p.RiskFactor.ToString().ToLower())'>Edit</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    function editProject(id, name, start, end, est, app, risk) {
        document.getElementById("ProjectId").value = id;
        document.getElementById("ProjectName").value = name;
        document.getElementById("StartSate").value = start;
        document.getElementById("EndDate").value = end;
        document.getElementById("EstimatedBudget").value = est;
        document.getElementById("ApprovedBudget").value = app;
        document.getElementById("RiskFactor").checked = risk;
        document.getElementById("btnSave").textContent = "Update";
        document.getElementById("btnSave").className = "btn btn-success";
    }

    function resetProjectForm() {
        document.getElementById("ProjectId").value = 0;
        document.getElementById("ProjectName").value = "";
        document.getElementById("EstimatedBudget").value = "";
        document.getElementById("ApprovedBudget").value = "";
        document.getElementById("RiskFactor").checked = false;
        document.getElementById("btnSave").textContent = "Add";
        document.getElementById("btnSave").className = "btn btn-primary";
    }
</script>